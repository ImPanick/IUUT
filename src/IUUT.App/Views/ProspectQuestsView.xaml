<UserControl x:Class="IUUT.App.Views.ProspectQuestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:IUUT.App.Controls"
             mc:Ignorable="d">

    <!-- Prospect Quests (Tier 3). DataContext = ProspectQuestsViewModel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + prospect picker -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="PROSPECT QUESTS" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding ProfileLabel, StringFormat='Mission state inside “{0}”&#8217;s prospect world saves — reset a mission to replay it.'}"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding MissionSummary}" Style="{StaticResource MonoText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="1" Content="Reload" Command="{Binding LoadCommand}" VerticalAlignment="Top" Padding="12,4" />

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="PROSPECT" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox MinWidth="300" ItemsSource="{Binding Prospects}"
                              SelectedItem="{Binding SelectedProspect, Mode=TwoWay}" DisplayMemberPath="Name" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quest steps -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12" Margin="0,12,0,0">
            <Grid>
                <ItemsControl Style="{StaticResource VirtualizedList}" ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Padding="12,6" CornerRadius="4"
                                    Background="{StaticResource DataBackdropBrush}"
                                    BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding QuestName}" Style="{StaticResource BodyText}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="✓ complete" Style="{StaticResource MonoText}"
                                               Foreground="{StaticResource StateOkBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:StateDisplay Kind="Empty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Title="No mission here"
                                       Detail="This prospect's world save carries no quest state."
                                       Visibility="{Binding CanReset, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Status + reset -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="RESET MISSION" Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanReset}" Click="OnResetMission" />
        </Grid>
    </Grid>
</UserControl>
