<UserControl x:Class="IUUT.App.Views.LoadoutsViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Loadouts viewer (master §8.7), read-only. DataContext = LoadoutsViewerViewModel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="LOADOUTS — LOST GEAR RECOVERY" Style="{StaticResource LabelText}" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="A loadout remembers what you took down with you, so it is the last record of your gear when everything else is gone — a host who never came back, or a gravestone the game deleted. These two buttons put that gear back in your orbital stash." />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource MonoText}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="{Binding RestorableCount, StringFormat=PUT MY GEAR BACK ({0})}" Click="OnRestoreMissing"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanRestore}" Margin="0,0,6,0"
                            ToolTip="Recreates the stash items your loadouts reference but that have vanished — exact GUID and item row, so the loadout is whole again. Use this when a gravestone is gone and the gear went with it." />
                    <Button Content="{Binding UninsuredCount, StringFormat=Free gear held by a host ({0})}" Click="OnInsureAll"
                            IsEnabled="{Binding CanInsure}" Padding="12,4" Margin="0,0,6,0"
                            ToolTip="The safe version of the community bInsured hand-edit — releases gear stuck with a host who is offline or never coming back." />
                    <Button Content="Reload" Command="{Binding LoadCommand}" Padding="12,4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loadout cards -->
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Loadouts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="6"
                                Background="{StaticResource DataBackdropBrush}"
                                BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                            <StackPanel>
                                <!-- Prospect · slot, then state/insured/settled -->
                                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Flags}" Style="{StaticResource MutedText}" Margin="0,1,0,0" />

                                <!-- Envirosuit -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="ENVIROSUIT" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EnviroSuit}" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Meta items as wrapping chips -->
                                <TextBlock Text="{Binding ItemsHeader}" Style="{StaticResource LabelText}" Margin="0,10,0,6" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="7,3" Margin="0,0,5,5"
                                                    Background="{StaticResource GlassFillHoverBrush}"
                                                    BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding}" Style="{StaticResource MonoText}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                   Margin="2,12,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
