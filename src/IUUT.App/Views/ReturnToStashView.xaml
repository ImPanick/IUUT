<UserControl x:Class="IUUT.App.Views.ReturnToStashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:IUUT.App.Controls"
             mc:Ignorable="d">

    <!-- Return to Stash (Tier 2 RESCUE). DataContext = ReturnToStashViewModel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + prospect picker -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="RETURN TO STASH" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding ProfileLabel, StringFormat=Rescue items trapped in a prospect back to “{0}”&#8217;s orbital stash.}"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="1" Content="Reload" Command="{Binding LoadCommand}" VerticalAlignment="Top" Padding="12,4" />

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="PROSPECT" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox MinWidth="300" ItemsSource="{Binding Prospects}"
                              SelectedItem="{Binding SelectedProspect, Mode=TwoWay}" DisplayMemberPath="Name" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Trapped-item preview -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="4,2,0,8" />

                <ItemsControl Grid.Row="1" Style="{StaticResource VirtualizedList}" ItemsSource="{Binding TrappedItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Padding="12,6" CornerRadius="4"
                                    Background="{StaticResource DataBackdropBrush}"
                                    BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RowName}" Style="{StaticResource MonoText}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SlotCount, StringFormat={}{0} slot(s)}" Style="{StaticResource MonoText}" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding TotalQuantity, StringFormat=×{0}}" Style="{StaticResource BodyText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:StateDisplay Grid.Row="1" Kind="Empty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Title="Nothing trapped here"
                                       Detail="This prospect's world save holds no recoverable items."
                                       Visibility="{Binding HasTrapped, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- Status + return -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="RETURN ALL TO STASH" Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding HasTrapped}" Click="OnReturnAll" />
        </Grid>
    </Grid>
</UserControl>
