<UserControl x:Class="IUUT.App.Views.FieldGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:IUUT.App.Controls"
             mc:Ignorable="d">

    <!-- Field Guide (Tier 4). DataContext = FieldGuideViewModel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="FIELD GUIDE" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding ProfileLabel, StringFormat='Tracked statistics, fishing records, and checklists for “{0}” — the counters behind many accolades.'}"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource MonoText}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Reload" Command="{Binding LoadCommand}" VerticalAlignment="Top" Padding="12,4" />
            </Grid>
        </Border>

        <!-- Statistics (left) · Fish + checklists (right) -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="STATISTICS" Style="{StaticResource LabelText}" Margin="4,2,0,8" />
                    <controls:FilteredListBox Grid.Row="1" Source="{Binding StatsView}"
                                              SearchHint="Search statistics (name, category, or row)">
                        <controls:FilteredListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="12,6" CornerRadius="4"
                                        Background="{StaticResource DataBackdropBrush}"
                                        BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource MonoText}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Width="110" VerticalAlignment="Center" TextAlignment="Right"
                                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </controls:FilteredListBox.ItemTemplate>
                    </controls:FilteredListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Fish -->
                <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,2,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FISHING RECORDS" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Catch all" Command="{Binding CatchAllFishCommand}" Padding="10,3"
                                    ToolTip="Marks every fish not yet caught as caught once (review, then Apply)." />
                        </Grid>
                        <controls:FilteredListBox Grid.Row="1" Source="{Binding FishView}"
                                                  SearchHint="Search fish (name or row)">
                            <controls:FilteredListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="12,6" CornerRadius="4"
                                            Background="{StaticResource DataBackdropBrush}"
                                            BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1"
                                            ToolTip="{Binding Lore}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="  ✓" Style="{StaticResource BodyText}"
                                                               Foreground="{StaticResource StateOkBrush}"
                                                               Visibility="{Binding IsCaught, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource MonoText}" Margin="0,1,0,0"
                                                           Text="{Binding MaxWeight, StringFormat='best weight {0}'}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="caught" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBox Width="64" VerticalAlignment="Center" TextAlignment="Right"
                                                         Text="{Binding Caught, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </controls:FilteredListBox.ItemTemplate>
                        </controls:FilteredListBox>
                    </Grid>
                </Border>

                <!-- Checklists -->
                <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="CHECKLISTS" Style="{StaticResource LabelText}" Margin="4,2,0,8" />
                        <ItemsControl Grid.Row="1" Style="{StaticResource VirtualizedList}" ItemsSource="{Binding TaskLists}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="4"
                                            Background="{StaticResource DataBackdropBrush}"
                                            BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" Margin="8,2"
                                                                  VerticalContentAlignment="Center">
                                                            <TextBlock Text="{Binding Task}" Style="{StaticResource MonoText}" />
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status + apply -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="APPLY FIELD GUIDE" Style="{StaticResource PrimaryButton}" Click="OnApply" />
        </Grid>
    </Grid>
</UserControl>
